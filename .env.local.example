# Copie ce fichier en .env.local puis remplis-le.

# ── Base de données GymTrack (SQLite du backend) ─────────────────────────────
# Par défaut : la base locale de dev. Pour la prod, copie le fichier .db du
# serveur sur ta machine et mets son chemin ici (ouvert en lecture seule).
GYMTRACK_DB_PATH=../gym-track-v1/backend/dev.db

# ── Google Play Console ──────────────────────────────────────────────────────
# Sans ces variables, la section Play Store affiche des données de DÉMO.
PLAY_PACKAGE_NAME=com.gymstrack.app
# Play Console > Télécharger les rapports > Statistiques > "Copier l'URI Cloud Storage"
# ex: gs://pubsite_prod_rev_01234567890987654321/stats/installs/  → mets juste le nom du bucket
PLAY_REPORTS_BUCKET=pubsite_prod_rev_XXXXXXXXXXXXXXXXXXXX
# Chemin vers la clé JSON du compte de service (garde-la HORS du dossier du projet)
GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/zacha/secrets/play-dashboard-sa.json

# Fuseau pour les heatmaps jour/heure
DASHBOARD_TZ=America/Toronto
